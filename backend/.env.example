PORT=5000
MONGO_URI=your_mongodb_atlas_connection_string
JWT_SECRET=replace_with_a_long_random_string
JWT_EXPIRES_IN=7d
CLIENT_URL=http://localhost:5173

# Email (OTP + password reset) — Gmail SMTP example.
# Use a Gmail "App Password", not your normal password.
# If Render blocks port 587 on the free tier, use port 2525 instead.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_gmail_address@gmail.com
SMTP_PASS=your_gmail_app_password

# Google reCAPTCHA v2 — for local dev you can use Google's official test
# secret key below (always passes, works on localhost only). Get real
# keys at https://www.google.com/recaptcha/admin for portal.codexora.in
# before going to production.
RECAPTCHA_SECRET_KEY=6LeIxAcTAAAAAGG-vFI1TnRWxMZNFuojJ4WifJWe

# Cloudinary — for owner-uploaded client files/deliverables
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Shown in the header of invoice PDFs. Leave address/email blank to omit them.
COMPANY_NAME=Codexora Solutions
COMPANY_ADDRESS=
COMPANY_EMAIL=
